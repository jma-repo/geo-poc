# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
GEO_CLAUDE_MODEL=claude-opus-5-5
GEO_CLAUDE_EFFORT=medium
GEO_PROBE_CLAUDE_MODEL=claude-opus-5-5
GEO_PROBE_EFFORT=low

# Optional engines. Each is enabled only when its key (and model, where listed) is set.
OPENAI_API_KEY=
GEO_OPENAI_MODEL=
PERPLEXITY_API_KEY=
GEO_PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEO_GEMINI_MODEL=
