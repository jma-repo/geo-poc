# 复制为 .env 后填写。.env 不要提交到 git。
# API 密钥（Anthropic、Reddit、Apify、SMTP）不要放在这里，
# 在 n8n 界面 Credentials 里配置，n8n 会加密保存。

POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_VERSION=latest

# Claude：默认 claude-opus-5-5。痛点提取量大，想省钱可以改成 claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Reddit 要求 User-Agent 带上应用名和你的 Reddit 用户名
REDDIT_USER_AGENT=web:demand-radar:v0.1 (by /u/your_reddit_username)

# Apify Actor ID（形如 username/actor-name），在 Apify 商店里选一个 Amazon 评论 Actor
APIFY_REVIEWS_ACTOR=

# 周报邮件
DIGEST_FROM=radar@example.com
DIGEST_TO=you@example.com
